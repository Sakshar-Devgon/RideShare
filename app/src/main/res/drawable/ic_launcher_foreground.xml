<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Soft Drop Shadow for Depth -->
    <path
        android:pathData="M37,32 L60,32 C70,32 77,38 77,48 C77,56 71,61 63,62 L74,77 C75,78.5 74,80 72,80 L62,80 C60,80 58.5,79 57.5,77.5 L48,63 L44,63 L44,77 C44,79 42.5,80 40.5,80 C38.5,80 37,79 37,77 Z"
        android:fillColor="#40000000" />

    <!-- Main Stylized Highway "R" Body -->
    <path
        android:pathData="M35,30 L59,30 C69,30 76,36.5 76,46.5 C76,54.5 70,60 62,61 L73,76 C74,77.5 73,79 71,79 L61,79 C59,79 57.5,78 56.5,76.5 L47.5,62 L43,62 L43,76 C43,78 41.5,79 39.5,79 C37.5,79 35,78 35,76 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="35"
                android:startY="30"
                android:endX="76"
                android:endY="79"
                android:type="linear">
                <item android:offset="0.0" android:color="#A78BFA" />
                <item android:offset="0.35" android:color="#7C3AED" />
                <item android:offset="0.75" android:color="#6D28D9" />
                <item android:offset="1.0" android:color="#4C1D95" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Inner Cutout of the R Loop -->
    <path
        android:pathData="M43,38 L58,38 C63.5,38 67.5,41.5 67.5,46.5 C67.5,51.5 63.5,54.5 58,54.5 L43,54.5 Z"
        android:fillColor="#17092C" />

    <!-- Secondary Converging Highway Overpass (Vibrant Magenta-Cyan accent) -->
    <!-- Represents the shared route / carpooling connection -->
    <path
        android:pathData="M43,47 C48,47 54,49 60,55 L75,74 C76.5,76 75,78 73,78 L65,78 C63,78 61.5,77 60.5,75.5 L49,61 C46,58 43,56 40,56 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="40"
                android:startY="47"
                android:endX="75"
                android:endY="78"
                android:type="linear">
                <item android:offset="0.0" android:color="#EC4899" />
                <item android:offset="0.5" android:color="#A855F7" />
                <item android:offset="1.0" android:color="#38BDF8" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- White Highway Centerline Dashes along the Stem & Ramp -->
    <path
        android:pathData="M39,74 L39,36 C39,33.5 41,34 43,34"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="1.8"
        android:strokeLineCap="round" />

    <!-- Dashed Centerline on the R Loop -->
    <path
        android:pathData="M47,34 L58,34 C66,34 71.5,39.5 71.5,46.5 C71.5,53.5 66,58 58,58"
        android:strokeColor="#E9D5FF"
        android:strokeWidth="1.8"
        android:strokeLineCap="round" />

    <!-- Dashed Centerline shooting down the Right Speedway Leg -->
    <path
        android:pathData="M54,60 L68,76"
        android:strokeColor="#F0ABFC"
        android:strokeWidth="1.8"
        android:strokeLineCap="round" />

    <!-- Sparkling Location/Pickup Node at Top Loop (Gleaming White Circle) -->
    <path
        android:pathData="M66,34 A3,3 0 1,1 65.9,34"
        android:fillColor="#FFFFFF" />
    <path
        android:pathData="M66,31.5 L66,36.5 M63.5,34 L68.5,34"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="1.0"
        android:strokeLineCap="round" />
</vector>
