rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Users collection - users can read/write their own profile
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    
    // Rides collection - authenticated users can read all rides, write their own
    match /rides/{rideId} {
      allow read: if request.auth != null;

      // Allow ride creator to create their own rides
      allow create: if request.auth != null &&
                    request.auth.uid == request.resource.data.userId;

      // Allow ride creator to update their own rides
      // OR allow any authenticated user to accept rides
      allow update: if request.auth != null &&
                    (request.auth.uid == resource.data.userId ||
                     // Allow accepting rides - when changing from not accepted to accepted
                     (resource.data.accepted == false &&
                      request.resource.data.accepted == true));

      // Only ride creator can delete their rides
      allow delete: if request.auth != null &&
                    request.auth.uid == resource.data.userId;
    }
    
    // Ride history collection - users can read rides they were involved in
    match /rideHistory/{rideId} {
      allow read: if request.auth != null &&
        (request.auth.uid == resource.data.userId ||
         request.auth.uid == resource.data.acceptedBy);

      // Allow authenticated users to create history entries
      allow create: if request.auth != null;

      // Allow users to update/delete their own ride history
      allow update, delete: if request.auth != null &&
        (request.auth.uid == resource.data.userId ||
         request.auth.uid == resource.data.acceptedBy);
    }
    
    // Default deny all other documents
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
